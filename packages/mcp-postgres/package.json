{
  "name": "@huzhihui_c/mcp-postgres",
  "version": "1.0.0",
  "description": "An AWS-style MCP server for PostgreSQL query and schema operations.",
  "license": "MIT",
  "author": "huzhihui_c",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhihuihu/mcp-forge.git",
    "directory": "packages/mcp-postgres"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "postgresql",
    "database"
  ],
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-postgres": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "pnpm build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "pg": "^8.13.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.4"
  }
}
